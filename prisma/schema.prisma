// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// AUTH / USER
// ==========================================

enum UserRole {
  ADMIN
  OFFICIAL
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(OFFICIAL)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bookings  Booking[]
  auditLogs AuditLog[]
  timetableImports TimetableImport[]

  @@map("users")
}

// ==========================================
// ACADEMIC STRUCTURE
// ==========================================

model Department {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  programs  Program[]
  faculty   Faculty[]
  subjects  Subject[]
  resources Resource[]
  schedules Schedule[]
  bookings  Booking[]

  @@map("departments")
}

model Program {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  departmentId String?
  durationYears Int     @default(4)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department? @relation(fields: [departmentId], references: [id])
  schedules  Schedule[]

  @@map("programs")
}

model Faculty {
  id           String   @id @default(cuid())
  name         String
  shortCode    String?
  departmentId String?
  email        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department? @relation(fields: [departmentId], references: [id])
  schedules  Schedule[]

  @@map("faculty")
}

model Subject {
  id           String   @id @default(cuid())
  code         String
  name         String
  departmentId String?
  programId    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department? @relation(fields: [departmentId], references: [id])
  schedules  Schedule[]

  @@map("subjects")
}

// ==========================================
// RESOURCES
// ==========================================

enum ResourceType {
  CLASSROOM
  LAB
  SEMINAR_HALL
  AUDITORIUM
  CONFERENCE_ROOM
  OTHER
}

enum Block {
  LEFT
  RIGHT
}

model Resource {
  id           String       @id @default(cuid())
  code         String       @unique
  name         String
  type         ResourceType @default(CLASSROOM)
  block        Block
  floor        Int
  roomNumber   String
  departmentId String?
  capacity     Int          @default(40)
  description  String?
  hasProjector Boolean      @default(false)
  hasSmartBoard Boolean     @default(false)
  computerCount Int         @default(0)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  department       Department?       @relation(fields: [departmentId], references: [id])
  schedules        Schedule[]
  bookings         Booking[]
  maintenanceBlocks MaintenanceBlock[]

  @@map("resources")
}

// ==========================================
// SCHEDULES (Timetable entries)
// ==========================================

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

model Schedule {
  id           String    @id @default(cuid())
  dayOfWeek    DayOfWeek
  startTime    String    // "HH:mm" format, e.g. "09:00"
  endTime      String    // "HH:mm" format, e.g. "11:00"
  resourceId   String
  departmentId String?
  programId    String?
  year         Int?      // 1, 2, 3, 4
  section      String?   // Only for 1st year: "A", "B"
  subjectId    String?
  facultyId    String?
  timetableImportId String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  resource        Resource         @relation(fields: [resourceId], references: [id])
  department      Department?      @relation(fields: [departmentId], references: [id])
  program         Program?         @relation(fields: [programId], references: [id])
  subject         Subject?         @relation(fields: [subjectId], references: [id])
  faculty         Faculty?         @relation(fields: [facultyId], references: [id])
  timetableImport TimetableImport? @relation(fields: [timetableImportId], references: [id])

  @@index([resourceId, dayOfWeek])
  @@index([facultyId, dayOfWeek])
  @@index([departmentId])
  @@index([dayOfWeek])
  @@map("schedules")
}

// ==========================================
// BOOKINGS (Administrative allocations)
// ==========================================

enum BookingStatus {
  RESERVED
  CANCELLED
  COMPLETED
}

model Booking {
  id           String        @id @default(cuid())
  resourceId   String
  date         DateTime      @db.Date
  startTime    String        // "HH:mm"
  endTime      String        // "HH:mm"
  title        String
  departmentId String?
  notes        String?
  status       BookingStatus @default(RESERVED)
  createdById  String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  resource   Resource    @relation(fields: [resourceId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  createdBy  User        @relation(fields: [createdById], references: [id])

  @@index([resourceId, date])
  @@index([date])
  @@map("bookings")
}

// ==========================================
// MAINTENANCE BLOCKS
// ==========================================

model MaintenanceBlock {
  id         String   @id @default(cuid())
  resourceId String
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date
  reason     String
  createdById String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  resource Resource @relation(fields: [resourceId], references: [id])

  @@index([resourceId])
  @@map("maintenance_blocks")
}

// ==========================================
// TIMETABLE IMPORTS
// ==========================================

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model TimetableImport {
  id              String       @id @default(cuid())
  filename        String
  status          ImportStatus @default(PENDING)
  metadata        Json?
  importedById    String
  recordsImported Int          @default(0)
  recordsFailed   Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  importedBy User       @relation(fields: [importedById], references: [id])
  schedules  Schedule[]

  @@map("timetable_imports")
}

// ==========================================
// AUDIT LOG
// ==========================================

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}
